{
  "name": "2X Studio Motion Design Tokens",
  "version": "2.0.0",
  "author": "Turash Ahsan",
  "easings": {
    "snappyDecel": {
      "cubicBezier": [0.22, 1.0, 0.36, 1.0],
      "css": "cubic-bezier(0.22, 1.0, 0.36, 1.0)",
      "usage": "Entrances, slides, button settles, digit rolling"
    },
    "springOvershoot32": {
      "cubicBezier": [0.34, 1.32, 0.64, 1.0],
      "css": "cubic-bezier(0.34, 1.32, 0.64, 1.0)",
      "bouncePercentage": 32,
      "usage": "Scoreboard pops, badge reveals, button releases, hoop rebounds"
    },
    "progressRamping": {
      "cubicBezier": [0.65, 0.0, 0.25, 1.0],
      "css": "cubic-bezier(0.65, 0.0, 0.25, 1.0)",
      "usage": "Progress bars, loading fills, macro camera pans"
    },
    "linear": {
      "cubicBezier": [0.0, 0.0, 1.0, 1.0],
      "css": "linear",
      "usage": "Continuous 360 degree rotation, radar scanning, odometer blur spin"
    }
  },
  "timings": {
    "microInteraction": { "duration": 0.18, "unit": "seconds" },
    "tactilePress": { "duration": 0.12, "unit": "seconds" },
    "cardEntrance": { "duration": 0.40, "unit": "seconds" },
    "slideLoopTotal": { "duration": 5.0, "unit": "seconds", "fps": 60 },
    "brandExperienceLoopTotal": { "duration": 8.0, "unit": "seconds", "fps": 60 }
  },
  "colors": {
    "canvas": {
      "obsidian": "#07090E",
      "surfaceDark": "#0E121B",
      "surfaceElevated": "#151A26",
      "borderSubtle": "#232C3E"
    },
    "accents": {
      "fieryOrange": "#FF6B2C",
      "orangeTint": "#FFF5EE",
      "emeraldNeon": "#00E5A3",
      "tealGlow": "#14B8A6",
      "electricViolet": "#8B5CF6",
      "deepIndigo": "#6366F1",
      "precisionBlue": "#3C82F6"
    },
    "text": {
      "primary": "#F5F8FF",
      "secondary": "#9EADCC",
      "muted": "#667699"
    }
  }
}
